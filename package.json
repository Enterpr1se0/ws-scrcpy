{
  "name": "ws-scrcpy",
  "version": "0.9.0-dev",
  "description": "Web client for scrcpy and more",
  "scripts": {
    "clean": "npx rimraf dist",
    "dist:dev": "webpack --config webpack/ws-scrcpy.dev.ts --stats-error-details",
    "dist:dev:frontend": "webpack --config webpack/ws-scrcpy.dev.ts --config-name frontend --stats-error-details",
    "dist:dev:backend": "webpack --config webpack/ws-scrcpy.dev.ts --config-name backend --stats-error-details",
    "dist:prod": "webpack --config webpack/ws-scrcpy.prod.ts --stats-error-details",
    "dist:prod:frontend": "webpack --config webpack/ws-scrcpy.prod.ts --config-name frontend --stats-error-details",
    "dist:prod:backend": "webpack --config webpack/ws-scrcpy.prod.ts --config-name backend --stats-error-details",
    "build": "npm run dist:prod",
    "build:frontend": "npm run dist:prod:frontend",
    "build:backend": "npm run dist:prod:backend",
    "start": "cd dist && npm start",
    "script:dist:start": "node ./index.js",
    "lint": "eslint src/ --ext .ts",
    "format": "eslint src/ --fix --ext .ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Sergey Volkov <drauggres@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@dead50f7/adbkit": "^2.11.5",
    "express": "^4.22.2",
    "node-pty": "^1.1.0",
    "portfinder": "^1.0.38",
    "tslib": "^2.8.1",
    "ws": "^8.20.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@dead50f7/generate-package-json-webpack-plugin": "^2.6.1",
    "@types/bluebird": "^3.5.42",
    "@types/express": "^4.17.25",
    "@types/node": "^18.19.130",
    "@types/npmlog": "^7.0.0",
    "@types/webpack-node-externals": "^3.0.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "autoprefixer": "^10.5.0",
    "buffer": "^6.0.3",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-progress": "0.0.1",
    "file-loader": "^6.2.0",
    "h264-converter": "^0.1.4",
    "html-webpack-plugin": "^5.6.7",
    "ifdef-loader": "^2.3.2",
    "mini-css-extract-plugin": "^2.10.2",
    "mkdirp": "^1.0.4",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.14",
    "postcss-loader": "^8.2.1",
    "prettier": "^2.8.8",
    "recursive-copy": "^2.0.14",
    "rimraf": "^3.0.2",
    "svg-inline-loader": "^0.8.2",
    "sylvester.js": "^0.1.1",
    "tailwindcss": "^3.4.19",
    "tinyh264": "^0.0.7",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^4.10.0",
    "webpack-node-externals": "^3.0.0",
    "worker-loader": "^3.0.8",
    "xterm": "^4.19.0",
    "xterm-addon-attach": "^0.6.0",
    "xterm-addon-fit": "^0.5.0"
  }
}
