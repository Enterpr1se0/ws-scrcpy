{
  "name": "ws-scrcpy-frontend",
  "version": "0.9.0-dev",
  "description": "Browser web client for scrcpy and more (frontend only, served by the Go backend)",
  "scripts": {
    "clean": "npx rimraf ../go-backend/web/public",
    "dev": "vite",
    "preview": "vite preview",
    "dist:dev": "vite build --mode development",
    "dist:prod": "vite build --mode production",
    "dist": "npm run dist:prod",
    "lint": "eslint src/ --ext .ts",
    "format": "eslint src/ --fix --ext .ts",
    "build": "vite build --mode production"
  },
  "author": "Sergey Volkov <drauggres@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@dead50f7/adbkit": "^2.11.5",
    "h264-converter": "^0.1.4",
    "tslib": "^2.8.1",
    "xterm": "^5.3.0",
    "xterm-addon-attach": "^0.9.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/dom-webcodecs": "^0.1.18",
    "@types/node": "^20.19.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^5.2.1",
    "path-browserify": "^1.0.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "~5.6.3",
    "vite": "^7.3.6",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint-plugin-progress": "0.0.1"
  }
}
